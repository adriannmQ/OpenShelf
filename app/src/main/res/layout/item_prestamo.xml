<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvIdPrestamo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="#1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:background="@drawable/bg_inicial_usuario" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tvTituloPrestamoLibro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Título del libro"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvNombreUsuarioPrestamo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre del usuario"
                android:textSize="13sp"
                android:textColor="#616161"
                android:layout_marginTop="3dp" />

            <TextView
                android:id="@+id/tvFechaPrestamo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Desde: 2024-01-01"
                android:textSize="12sp"
                android:textColor="#9E9E9E"
                android:layout_marginTop="3dp" />

            <TextView
                android:id="@+id/tvEstadoPrestamo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activo"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:layout_marginTop="5dp" />

        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:rotation="180"
            android:contentDescription="Ver detalle"
            android:alpha="0.4" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>